{
  "name": "unraid-vitals",
  "version": "0.0.0",
  "private": true,
  "description": "A better Unraid dashboard — deeper analytics, live history, disk and container insight.",
  "license": "MIT",
  "author": "hazemhagrass",
  "type": "module",
  "scripts": {
    "build": "bash build/build.sh",
    "lint:php": "find src -name '*.php' -not -path '*/node_modules/*' -print0 | xargs -0 -n1 php -l",
    "lint:js": "find src \\( -name '*.js' -o -name '*.mjs' \\) -not -path '*/node_modules/*' -print0 | xargs -0 -n1 node --check",
    "lint:shell": "find src build -name '*.sh' -not -path '*/node_modules/*' -print0 | xargs -0 -n1 bash -n",
    "test": "bash scripts/run-tests.sh",
    "check": "npm run lint:php && npm run lint:js && npm run lint:shell && npm test"
  }
}
