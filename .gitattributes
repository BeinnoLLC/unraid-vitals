# unraid-vitals — normalize line endings on checkout.
#
# A Windows clone with core.autocrlf=true otherwise ends up with CRLF in
# install.sh, remove.sh, build.sh and friends — Unraid then fails them with
# "bad interpreter: /bin/bash^M". Force LF for everything text, and mark the
# known binaries explicitly so git never tries to diff or convert them.

* text=auto eol=lf

*.sh   text eol=lf
*.php  text eol=lf
*.page text eol=lf
*.mjs  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.cfg  text eol=lf
*.plg  text eol=lf
*.xml  text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
