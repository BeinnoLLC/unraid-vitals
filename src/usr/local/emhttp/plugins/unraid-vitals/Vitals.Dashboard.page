<div class="vitals v-tile">
  <link type="text/css" rel="stylesheet" href="/plugins/unraid-vitals/css/vitals.css">
  <div class="v-tile-head">
    <span class="v-tile-title"><i class="fa fa-heartbeat"></i> Vitals</span>
    <a class="v-tile-link" href="/Vitals">open &rarr;</a>
  </div>
  <div id="vitals-tile" class="v-tile-body">
    <div class="v-tile-cards">
      <div class="v-tile-card"><span>CPU</span><b data-k="cpu">—</b></div>
      <div class="v-tile-card"><span>MEM</span><b data-k="mem">—</b></div>
      <div class="v-tile-card"><span>TEMP</span><b data-k="temp">—</b></div>
      <div class="v-tile-card"><span>DISK</span><b data-k="disk">—</b></div>
    </div>
    <div id="vitals-tile-spark" class="v-tile-spark"></div>
  </div>
  <style>
    .vitals.v-tile { font-size: 13px; }
    .v-tile-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .v-tile-title { font-weight: 600; opacity: .85; }
    .v-tile-link { font-size: 12px; opacity: .6; text-decoration: none; }
    .v-tile-link:hover { opacity: 1; }
    .v-tile-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
    .v-tile-card {
      background: rgba(127,127,127,.1); border: 1px solid rgba(127,127,127,.2);
      border-radius: 7px; padding: 6px 8px; text-align: center;
    }
    .v-tile-card span { display: block; font-size: 10px; letter-spacing: .07em; opacity: .55; }
    .v-tile-card b { font-size: 17px; font-weight: 600; }
    .v-tile-spark { margin-top: 8px; height: 46px; }
    .v-tile-spark svg { width: 100%; height: 100%; display: block; overflow: visible; }
  </style>

  <script>
  (function () {
    var base = '/plugins/unraid-vitals/include/ajax.php';

    function fmtB(n) {
      if (n == null) return '—';
      var u = ['B','KiB','MiB','GiB','TiB'], i = 0; n = Number(n);
      while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; }
      return n.toFixed(i > 2 ? 1 : 0) + u[i];
    }
    function cls(v, w, c) { return v == null ? 'muted' : (v >= c ? 'crit' : v >= w ? 'warn' : ''); }

    function spark(ring) {
      var host = document.getElementById('vitals-tile-spark');
      if (!host) return;
      var pts = ring.slice(-60).map(function (p) { return [p.t, p.cpu]; }).filter(function (p) { return p[1] != null; });
      if (pts.length < 2) { host.innerHTML = ''; return; }
      var W = 300, H = 46;
      var t0 = pts[0][0], t1 = pts[pts.length - 1][0]; if (t1 <= t0) t1 = t0 + 1;
      var d = pts.map(function (p, i) {
        var x = W * (p[0] - t0) / (t1 - t0);
        var y = H - (H - 4) * Math.max(0, Math.min(1, p[1] / 100)) - 2;
        return (i ? 'L' : 'M') + x.toFixed(1) + ' ' + y.toFixed(1);
      }).join(' ');
      host.innerHTML = '<svg viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="none">' +
        '<path d="' + d + ' L' + W + ' ' + H + ' L0 ' + H + ' Z" fill="#4f9cf9" fill-opacity=".15"/>' +
        '<path d="' + d + '" fill="none" stroke="#4f9cf9" stroke-width="1.8" vector-effect="non-scaling-stroke"/>' +
        '</svg>';
    }

    function paint(j) {
      var s = j.data || {}, arr = s.array || {};
      var temps = [];
      (arr.data || []).concat(arr.parity || []).forEach(function (x) { if (x.temp != null) temps.push(x.temp); });
      var t = temps.length ? Math.max.apply(null, temps) : null;
      var f = function (k, v, c) {
        var n = document.querySelector('#vitals-tile [data-k="' + k + '"]');
        if (n) { n.textContent = v; n.className = c || ''; }
      };
      var cpu = s.cpu ? s.cpu.total : null;
      f('cpu', cpu == null ? '—' : cpu.toFixed(0) + '%', cls(cpu, 80, 95));
      f('mem', s.mem ? s.mem.pct.toFixed(0) + '%' : '—', cls(s.mem && s.mem.pct, 80, 92));
      f('temp', t == null ? '—' : t + '°', cls(t, 45, 55));
      f('disk', arr.totals ? arr.totals.used_pct.toFixed(0) + '%' : '—', cls(arr.totals && arr.totals.used_pct, 85, 95));
      spark(j.ring || []);
    }

    function tick() {
      fetch(base + '?action=data', { cache: 'no-store' })
        .then(function (r) { return r.json(); })
        .then(paint)
        .catch(function () {});
    }

    tick();
    setInterval(tick, 60000);
  })();
  </script>
</div>
