<?php
/* unraid-vitals — settings */
$cfgFile = '/boot/config/plugins/unraid-vitals/vitals.cfg';
$cfg = is_file($cfgFile) ? @parse_ini_file($cfgFile) : [];
$interval = $cfg['INTERVAL'] ?? '1';
$keep     = $cfg['KEEP_DAYS'] ?? '90';
$startpage= $cfg['SET_STARTPAGE'] ?? 'no';
$log      = '/var/tmp/unraid-vitals/collector.log';
$logTail  = is_file($log) ? trim((string)@file_get_contents($log)) : '';
$lastRun  = is_file('/var/tmp/unraid-vitals/latest.json')
  ? json_decode((string)file_get_contents('/var/tmp/unraid-vitals/latest.json'), true) : null;
?>

<link type="text/css" rel="stylesheet" href="/plugins/unraid-vitals/css/vitals.css">

<div class="vitals">
  <div class="v-head">
    <div class="v-title">
      <h2><i class="fa fa-heartbeat"></i> Vitals Settings</h2>
      <span class="v-sub">Collector, retention and dashboard integration</span>
    </div>
    <div class="v-actions">
      <a class="v-btn" href="/Vitals"><i class="fa fa-line-chart"></i> Open Vitals</a>
    </div>
  </div>

  <div class="v-grid">
    <section class="v-panel">
      <h3>Collector</h3>
      <table>
        <tr><td>Status</td><td class="num v-name">
          <?php if ($lastRun): ?>
            <span class="ok">running</span>
          <?php else: ?>
            <span class="warn">no sample yet</span>
          <?php endif; ?>
        </td></tr>
        <tr><td>Last sample</td><td class="num v-name">
          <?= $lastRun && isset($lastRun['time']) ? date('Y-m-d H:i:s', (int)$lastRun['time']) : '—' ?>
        </td></tr>
        <tr><td>Cron interval</td><td class="num v-name">every <?=$interval?> minute(s)</td></tr>
        <tr><td>Ring buffer</td><td class="num v-name">
          <?php
            $ring = is_file('/var/tmp/unraid-vitals/history.json')
              ? json_decode((string)file_get_contents('/var/tmp/unraid-vitals/history.json'), true) : [];
            echo is_array($ring) ? count($ring) . ' samples (~' . round(count($ring) * (int)$interval / 60 / 24, 1) . ' days)' : '0';
          ?>
        </td></tr>
        <tr><td>Flash rollups</td><td class="num v-name">
          <?php
            $dir = '/boot/config/plugins/unraid-vitals/history';
            $size = 0; $files = is_dir($dir) ? glob($dir . '/*.jsonl') : [];
            foreach ($files as $f) $size += (int)@filesize($f);
            echo count($files) . ' file(s), ' . round($size / 1024, 1) . ' KiB';
          ?>
        </td></tr>
      </table>
    </section>

    <section class="v-panel">
      <h3>Preferences</h3>
      <form markdown="1" method="POST" action="/update.htm" target="progressFrame">
        <input type="hidden" name="csrf_token" value="<?=$var['csrf_token']?>">
        <input type="hidden" name="#file" value="/boot/config/plugins/unraid-vitals/vitals.cfg">
        <!-- Re-apply cron + start page immediately after the file is written,
             otherwise an interval change would only take effect on next boot. -->
        <input type="hidden" name="#command" value="/usr/local/emhttp/plugins/unraid-vitals/scripts/install.sh">
        <input type="hidden" name="#arg[1]" value="--reapply">

        <table>
          <tr>
            <td>Sample interval</td>
            <td><select name="INTERVAL">
              <?php foreach ([1, 2, 5, 10] as $i): ?>
                <option value="<?=$i?>" <?=$interval == $i ? 'selected' : ''?>><?=$i?> minute<?=$i > 1 ? 's' : ''?></option>
              <?php endforeach; ?>
            </select></td>
          </tr>
          <tr>
            <td>Keep daily rollups</td>
            <td><select name="KEEP_DAYS">
              <?php foreach ([30, 90, 180, 365] as $d): ?>
                <option value="<?=$d?>" <?=$keep == $d ? 'selected' : ''?>><?=$d?> days</option>
              <?php endforeach; ?>
            </select></td>
          </tr>
          <tr>
            <td>Set as start page</td>
            <td><select name="SET_STARTPAGE">
              <option value="no" <?=$startpage === 'no' ? 'selected' : ''?>>No</option>
              <option value="yes" <?=$startpage === 'yes' ? 'selected' : ''?>>Yes — land on Vitals instead of the stock dashboard</option>
            </select></td>
          </tr>
        </table>

        <h4 style="margin:14px 0 6px">Alerts <span class="v-card-sub">(delivered through Unraid's own notification centre)</span></h4>
        <table>
          <tr>
            <td>Disk temperature warning</td>
            <td><input type="number" name="ALERT_TEMP" min="30" max="80" value="<?=htmlspecialchars((string)($cfg['ALERT_TEMP'] ?? 55))?>" style="width:5em"> °C</td>
          </tr>
          <tr>
            <td>Array fill warning</td>
            <td><input type="number" name="ALERT_FILL" min="50" max="100" value="<?=htmlspecialchars((string)($cfg['ALERT_FILL'] ?? 90))?>" style="width:5em"> %</td>
          </tr>
          <tr>
            <td>Load-average limit</td>
            <td><input type="number" name="ALERT_LOAD" min="0" max="256" step="0.5" value="<?=htmlspecialchars((string)($cfg['ALERT_LOAD'] ?? 0))?>" style="width:5em"> <span class="v-card-sub">(0 = off)</span></td>
          </tr>
          <tr>
            <td>Container down after</td>
            <td><input type="number" name="ALERT_RESTARTS" min="0" max="60" value="<?=htmlspecialchars((string)($cfg['ALERT_RESTARTS'] ?? 3))?>" style="width:5em"> samples <span class="v-card-sub">(0 = off)</span></td>
          </tr>
        </table>
        <div class="v-card-sub">SMART reallocated / pending sectors always alert. Each alert repeats at most once per hour.</div>

        <input type="submit" name="#apply" value="Apply">
        <input type="button" value="Sample now" onclick="VitalsSettings.sample()">
      </form>
      <div class="v-card-sub" style="margin-top:10px">
        "Set as start page" writes <code>START_PAGE</code> in Unraid's own display
        settings. The stock dashboard is left untouched and stays reachable at
        /Dashboard.
      </div>
    </section>
  </div>

  <div class="v-grid">
    <section class="v-panel v-span2">
      <h3>Collector log</h3>
      <pre class="v-mono v-scroll" style="max-height:220px;margin:0;white-space:pre-wrap"><?=htmlspecialchars($logTail ?: '(no output yet)')?></pre>
    </section>
  </div>
</div>

<script>
var VitalsSettings = {
  sample: function () {
    fetch('/plugins/unraid-vitals/include/ajax.php?action=refresh', { cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(function () { location.reload(); })
      .catch(function () { alert('Sampling failed — check the collector log.'); });
  }
};
</script>
